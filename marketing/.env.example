# Copy to .env (local) or set in Vercel > Project > Settings > Environment Variables.
# All PUBLIC_ values end up in the page HTML. Never put secrets here.

# Where "Start free" buttons go. The sign-up page is PUBLIC_APP_URL + /sign-up
PUBLIC_APP_URL=https://app.example.com

# WhatsApp business number in international format, digits only, no + or spaces (Zimbabwe example: 263771234567)
PUBLIC_WHATSAPP_NUMBER=263000000000

# The public address of this marketing site (canonical URL, sitemap, social tags)
PUBLIC_SITE_URL=https://myfleet.example.com

# Optional. Set to your domain to turn on the Plausible snippet (cookieless, about 1 KB). Leave empty for no analytics.
PUBLIC_PLAUSIBLE_DOMAIN=
