---
import '../styles/global.css';
import fontUrl from '../../node_modules/@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import { brand } from '../content/site';
import { siteUrl, plausibleDomain } from '../lib/links';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  jsonLd?: object;
}
const { title = brand.title, description = brand.description, path = '/', noindex = false, jsonLd } = Astro.props;
const canonical = `${siteUrl}${path === '/' ? '' : path}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="myfleet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {plausibleDomain && <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script is:inline>
      // Scroll reveals and the header's scroll edge. Everything stays visible if this never runs.
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var els = document.querySelectorAll('[data-reveal], .stage');
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach(function (e) { e.classList.add('in'); });
        } else {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
            });
          }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
          els.forEach(function (e) { io.observe(e); });
        }
        var top = document.querySelector('.top');
        if (top) {
          var onScroll = function () { top.classList.toggle('scrolled', window.scrollY > 8); };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }
      })();
    </script>
      <script is:inline>
      // Hero headline: swap the pain line. Stops for reduced motion and when the tab is hidden.
      (function () {
        var h = document.getElementById('h1');
        if (!h || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var p = h.querySelectorAll('.pain'), i = 0;
        if (p.length < 2) return;
        var gap = parseInt(h.getAttribute('data-rotate-ms'), 10) || 4200;
        setInterval(function () {
          if (document.hidden) return;
          p[i].classList.remove('on'); p[i].setAttribute('aria-hidden', 'true');
          i = (i + 1) % p.length;
          p[i].classList.add('on'); p[i].removeAttribute('aria-hidden');
        }, gap);
      })();
    </script>
</body>
</html>
