---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import LogbookToInvoice from '../components/LogbookToInvoice.astro';
import WhatsAppQr from '../components/WhatsAppQr.astro';
import Shot from '../components/Shot.astro';
import ChatIcon from '../components/ChatIcon.astro';
import alleaLogo from '../assets/allea-logo.png';
import { brand, hero, story, shots, proof, pricing, faq, finalCta, cta } from '../content/site';
import { signUpUrl, waHero, waPricing, waQuestion, siteUrl } from '../lib/links';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'myfleet',
  url: siteUrl,
  description: brand.description,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web browser',
  offers: pricing.plans.map((p) => ({
    '@type': 'Offer',
    name: p.name,
    description: `${p.trucks}, per month. ${p.free}.`,
    price: p.price.replace('$', ''),
    priceCurrency: 'USD',
  })),
};
---
<Base jsonLd={jsonLd}>
  <Header />
  <main id="main">
    <!-- The pain, then the way out -->
    <section class="hero" aria-labelledby="h1">
      <div class="wrap">
        <h1 id="h1" class="rise" data-rotate-ms={hero.rotateMs}>
          <span class="h1-lead">{hero.h1Lead}</span>
          <span class="rotor">
            {hero.h1Pains.map((t, i) => <span class:list={['pain', { on: i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>{t}</span>)}
          </span>
        </h1>
        <p class="lede rise" style="--d: 80ms">{hero.sub}</p>
        <div class="btn-row center rise" style="--d: 160ms">
          <a class="btn btn-primary btn-lg" href={signUpUrl}>{cta.primary}</a>
          <a class="btn btn-quiet btn-lg" href={waHero} rel="noopener"><ChatIcon />{cta.whatsappLong}</a>
        </div>
        <p class="small center rise" style="--d: 220ms">{hero.small}</p>
      </div>
      <div class="hero-shot wrap rise" style="--d: 300ms">
        <Shot id="hero" eager sizes="(min-width: 1180px) 1120px, 100vw" />
      </div>
    </section>

    <!-- 1. The logbook -->
    <section class="scene" aria-labelledby="s-logbook">
      <div class="wrap split">
        <div data-reveal>
          <h2 id="s-logbook">{story.logbook.pain}</h2>
          <p>{story.logbook.body}</p>
        </div>
        <div data-reveal class="d1"><LogbookToInvoice /></div>
      </div>
      <div class="wrap narrow-shot" data-reveal>
        <Shot id="import" />
        <p class="caption">{story.logbook.excel}</p>
      </div>
      <div class="wrap"><p class="handoff" data-reveal>{story.logbook.lead}</p></div>
    </section>

    <!-- 2. Never billed -->
    <section class="scene" aria-labelledby="s-unbilled">
      <div class="wrap">
        <div class="head" data-reveal>
          <h2 id="s-unbilled">{story.unbilled.pain}</h2>
          <p>{story.unbilled.body}</p>
        </div>
        <div class="stack" data-reveal>
          <Shot id="notInvoiced" />
          <div class="over"><Shot id="invoices" sizes="(min-width: 1080px) 640px, 80vw" /></div>
        </div>
        <p class="small center" data-reveal>{story.unbilled.note}</p>
      </div>
      <div class="wrap"><p class="handoff" data-reveal>{story.unbilled.lead}</p></div>
    </section>

    <!-- 3. Paid late -->
    <section class="scene" aria-labelledby="s-owed">
      <div class="wrap">
        <div class="head" data-reveal>
          <h2 id="s-owed">{story.owed.pain}</h2>
          <p>{story.owed.body}</p>
        </div>
        <div class="wide-shot" data-reveal><Shot id="whoOwes" sizes="(min-width: 1080px) 1040px, 100vw" /></div>
      </div>
      <div class="wrap"><p class="handoff" data-reveal>{story.owed.lead}</p></div>
    </section>

    <!-- 4. What each trip really made -->
    <section class="scene" aria-labelledby="s-profit">
      <div class="wrap">
        <div class="head" data-reveal>
          <h2 id="s-profit">{story.profit.pain}</h2>
          <p>{story.profit.body}</p>
        </div>
        <div class="pair" data-reveal>
          <Shot id="trips" sizes="(min-width: 1080px) 560px, 100vw" />
          <Shot id="profitability" sizes="(min-width: 1080px) 480px, 100vw" />
        </div>
      </div>
      <div class="wrap"><p class="handoff" data-reveal>{story.profit.lead}</p></div>
    </section>

    <!-- 5. The small leaks -->
    <section class="scene" aria-labelledby="s-leaks">
      <div class="wrap">
        <div class="head" data-reveal>
          <h2 id="s-leaks">{story.leaks.pain}</h2>
          <p>{story.leaks.intro}</p>
        </div>
        <div class="cards">
          {story.leaks.items.map((item, i) => (
            <article class="card" data-reveal style={`--d: ${i * 70}ms`}>
              <Shot id={item.id as keyof typeof shots} sizes="(min-width: 1080px) 520px, 100vw" />
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="wrap"><p class="handoff" data-reveal>{story.leaks.lead}</p></div>
    </section>

    <!-- 6. Only what you need -->
    <section class="scene" aria-labelledby="s-modules">
      <div class="wrap split">
        <div data-reveal>
          <h2 id="s-modules">{story.modules.pain}</h2>
          <p>{story.modules.body}</p>
        </div>
        <div data-reveal class="d1 fade-bottom"><Shot id="modules" sizes="(min-width: 1080px) 560px, 100vw" /></div>
      </div>
    </section>

    <!-- 7. Proof -->
    <section class="scene" aria-labelledby="s-proof">
      <div class="wrap">
        <div class="proof" data-reveal>
          <div>
            <h2 id="s-proof">{proof.h2}</h2>
            {proof.body.map((p) => <p>{p}</p>)}
            <p class="small">{proof.disclosure}</p>
          </div>
          <div class="logo-tile">
            <Image src={alleaLogo} width={320} format="webp" quality={70} alt={proof.logoAlt} loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- 8. Price -->
    <section class="scene" id="price" aria-labelledby="s-price">
      <div class="wrap">
        <div class="head center-head" data-reveal>
          <h2 id="s-price">{pricing.h2}</h2>
          <p>{pricing.sub}</p>
        </div>
        <div class="plans">
          {pricing.plans.map((p, i) => (
            <div class="plan" data-reveal style={`--d: ${i * 70}ms`}>
              <span class="free">{p.free}</span>
              <h3>{p.name}</h3>
              <p class="trucks">{p.trucks}</p>
              <p class="price">{p.price}<small>{pricing.perMonth}</small></p>
              <a class="btn btn-primary" href={signUpUrl}>{p.cta}</a>
            </div>
          ))}
        </div>
        <ul class="included" data-reveal>
          {pricing.included.map((i) => <li><b>{i.title}</b><span>{i.text}</span></li>)}
        </ul>
        <ul class="promises" data-reveal>
          {pricing.promises.map((i) => <li><b>{i.title}</b> {i.text}</li>)}
        </ul>
        <p class="small center">{pricing.currency} <a href={waPricing} rel="noopener">{pricing.more}</a></p>
      </div>
    </section>

    <!-- 9. Questions -->
    <section class="scene" id="questions" aria-labelledby="s-faq">
      <div class="wrap narrow">
        <h2 id="s-faq" data-reveal>{faq.h2}</h2>
        <div class="faq" data-reveal>
          {faq.items.map((f, i) => (
            <details open={i < faq.openFirst}>
              <summary>{f.q}</summary>
              <div class="a">
                <p>{f.a}{f.links && f.links.map((l) => <> <a href={l.href}>{l.label}</a></>)}</p>
              </div>
            </details>
          ))}
        </div>
        <p class="center" data-reveal style="margin-top: 28px">
          <a class="btn btn-quiet" href={waQuestion} rel="noopener"><ChatIcon />{cta.stillNotSure}</a>
        </p>
      </div>
    </section>

    <!-- 10. Close -->
    <section class="close" aria-labelledby="s-final">
      <div class="wrap center">
        <h2 id="s-final" data-reveal>{finalCta.h2}</h2>
        <p class="lede" data-reveal>{finalCta.body}</p>
        <div class="btn-row center" data-reveal>
          <a class="btn btn-primary btn-lg" href={waHero} rel="noopener"><ChatIcon />{finalCta.primary}</a>
          <a class="btn btn-quiet btn-lg" href={signUpUrl}>{finalCta.secondary}</a>
        </div>
        <p class="small" data-reveal>{finalCta.small}</p>
        <div class="qr-wrap" data-reveal><WhatsAppQr /></div>
      </div>
      <div class="wrap close-shot fade-bottom" data-reveal>
        <Shot id="dashboard" sizes="(min-width: 1180px) 1000px, 100vw" />
      </div>
    </section>
  </main>
  <Footer />
  <StickyBar />
</Base>
