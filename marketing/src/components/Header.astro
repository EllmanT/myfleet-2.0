---
import Wordmark from './Wordmark.astro';
import { nav } from '../content/site';
import { signUpUrl, signInUrl } from '../lib/links';
const { home = true } = Astro.props;
---
<header class="top">
  <div class="wrap">
    <a class="brand" href="/" aria-label="myfleet home"><Wordmark size={24} /></a>
    <nav aria-label="Main">
      {home && nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href={signInUrl}>{nav.signIn}</a>
    </nav>
    <a class="btn btn-primary btn-sm" href={signUpUrl}>{nav.start}</a>
  </div>
</header>
