---
// myfleet logo. Two artworks, swapped by screen width so the name never gets squeezed:
// the stacked mark (M over FLEET) on narrow screens, the MYFLEET text logo from 640px up.
// `size` is the height of the text logo in px; the stacked one is scaled to match visually.
const { size = 22 } = Astro.props;
const stackedH = Math.round(size * 2.4);
---
<span class="logo" style={`--logo-h:${size}px;--logo-stacked-h:${stackedH}px`}>
  <img class="logo-stacked" src="/brand/myfleet-logo-stacked.png" width="470" height="387" alt="myfleet" decoding="async" />
  <img class="logo-text" src="/brand/myfleet-logo-text.png" width="418" height="51" alt="myfleet" decoding="async" />
</span>
