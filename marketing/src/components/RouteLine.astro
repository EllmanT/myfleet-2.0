---
// Plain SVG route map: one stroke weight, city dots, border posts as accent squares.
// Draws once as it scrolls into view where the browser supports scroll timelines.
---
<figure class="frame" role="img" aria-label="Example routes: Harare to Beitbridge to Johannesburg, and Harare to Mutare to Beira, with the Beitbridge and Machipanda border posts marked.">
  <div class="frame-bar" aria-hidden="true"><span>Example routes and border posts</span><span class="demo-tag">Illustration</span></div>
  <div class="route-body">
    <svg class="route" viewBox="0 0 400 190" aria-hidden="true">
      <path class="line" pathLength="1" d="M130 40 L168 108 L112 160" />
      <path class="line" pathLength="1" d="M130 40 L248 54 L296 70 L352 108" />
      <circle class="city" cx="130" cy="40" r="5" /><text x="108" y="28">Harare</text>
      <circle class="city" cx="248" cy="54" r="5" /><text x="236" y="42">Mutare</text>
      <rect class="post" x="291" y="65" width="10" height="10" /><text class="post-label" x="266" y="94">Machipanda</text>
      <circle class="city" cx="352" cy="108" r="5" /><text x="334" y="128">Beira</text>
      <rect class="post" x="163" y="103" width="10" height="10" /><text class="post-label" x="180" y="107">Beitbridge</text>
      <circle class="city" cx="112" cy="160" r="5" /><text x="126" y="164">Johannesburg</text>
    </svg>
  </div>
</figure>
