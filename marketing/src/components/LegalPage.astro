---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { legal } from '../content/site';
const { doc, path } = Astro.props as { doc: { title: string; sections: { id: string; h: string; p: string }[] }; path: string };
---
<Base title={`${doc.title} | myfleet`} description={`${doc.title} for myfleet.`} path={path}>
  <Header home={false} />
  <main id="main" class="wrap legal">
    <h1>{doc.title}</h1>
    <p class="small">{legal.updated}</p>
    {doc.sections.map((s) => (
      <section id={s.id} aria-labelledby={`${s.id}-h`}>
        <h2 id={`${s.id}-h`}>{s.h}</h2>
        <p>{s.p}</p>
      </section>
    ))}
  </main>
  <Footer />
</Base>
