---
// The hero sequence: a logbook page gets four fields underlined, then turns into the invoice
// with the same values. Pure HTML and CSS, plays once (about 3.4 s), ends on the invoice.
// With prefers-reduced-motion (or reduced data) it shows the page and the invoice side by side, static.
//
// REAL PHOTO SLOT: to use a real photo of a dummy logbook page, pass it as the "photo" slot:
//   wrap a picture element with slot="photo" (width, height and fetchpriority="high" set) inside this component.
// The slot replaces the drawn page. Position the underline marks (.mark) for your photo with the
// --mx / --my / --mw custom properties on each .mark element below.
import { demoTrip as t, hero } from '../content/site';
---
<figure class="stage" role="img" aria-label={hero.logbookAlt}>
  <div class="sheet logbook" aria-hidden="true">
    <slot name="photo">
      <div class="lb-head">
        <span>Daily vehicle log</span>
        <span>Veh. <u>{t.vehicle}</u></span>
      </div>
      <div class="lb-grid lb-cols">
        <span>Date</span><span>Driver</span><span>Out</span><span>In</span><span>From</span><span>To</span>
      </div>
      <div class="lb-grid"><span>01 Nov</span><span>T. Moyo</span><span>183 540</span><span>183 972</span><span>Harare</span><span>Mutare</span></div>
      <div class="lb-grid"><span>02 Nov</span><span>T. Moyo</span><span>183 972</span><span>184 058</span><span>Mutare</span><span>Harare</span></div>
      <div class="lb-grid"><span>03 Nov</span><span>B. Dube</span><span>184 410</span><span>184 640</span><span>Harare</span><span>Gweru</span></div>
      <div class="lb-grid target">
        <span class="f f-date">{t.date}<i class="mark"></i></span>
        <span>{t.driver}</span>
        <span class="f f-km">{t.out}<i class="mark"></i></span>
        <span class="f f-km2">{t.in}<i class="mark"></i></span>
        <span class="f f-route">{t.from}<i class="mark"></i></span>
        <span class="f f-route2">{t.to}<i class="mark"></i></span>
      </div>
      <div class="lb-grid lb-blank"><span></span><span></span><span></span><span></span><span></span><span></span></div>
      <div class="lb-grid lb-blank"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    </slot>
  </div>

  <div class="arrow" aria-hidden="true">
    <svg viewBox="0 0 40 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M0 8h36M30 2l7 6-7 6" /></svg>
  </div>

  <div class="sheet invoice" aria-hidden="true">
    <div class="inv-top">
      <b>Invoice</b>
      <span>{t.invoiceNo}</span>
    </div>
    <div class="inv-parties">
      <div><span class="k">From</span>{t.company}</div>
      <div><span class="k">Bill to</span>{t.customer}</div>
    </div>
    <div class="inv-line">
      <div>
        <span>{t.from} to {t.to}</span>
        <small>{t.date} &middot; {t.vehicle} &middot; {t.out} to {t.in} &middot; {t.km} km</small>
      </div>
      <span class="amt">{t.amount}</span>
    </div>
    <div class="inv-total"><span>Total due</span><b>{t.amount}</b></div>
    <p class="inv-note">Business document, not a ZIMRA fiscal tax invoice.</p>
  </div>
  <figcaption class="cap"><span>{hero.figLabel}</span><span>{hero.demoCaption}</span></figcaption>
</figure>

<style>
  .stage {
    margin: 0;
    display: grid;
    gap: 16px;
    container-type: inline-size;
  }
  .sheet {
    container-type: inline-size;
    border-radius: 4px;
    font-size: 13px;
    line-height: 1.35;
  }
  .logbook {
    background: var(--paper);
    color: var(--paper-ink);
    font-family: var(--font-mono);
    padding: 16px 14px 14px;
    border: 1px solid #cfc7b2;
    transform: rotate(-1deg);
    /* ruled lines */
    background-image: repeating-linear-gradient(to bottom, transparent 0 25px, rgba(60, 70, 120, 0.16) 25px 26px);
    background-position: 0 30px;
  }
  .lb-head {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-bottom: 10px;
    height: 30px;
  }
  .lb-head u {
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .lb-grid {
    display: grid;
    grid-template-columns: 1.1fr 1.2fr 1.1fr 1.1fr 1.2fr 1.2fr;
    gap: 4px;
    height: 26px;
    align-items: end;
    padding-bottom: 3px;
    font-size: clamp(9.5px, 3cqw, 11.5px);
    white-space: nowrap;
  }
  .lb-cols {
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .f {
    position: relative;
    display: inline-block;
  }
  .mark {
    position: absolute;
    left: -2px;
    right: -2px;
    bottom: -3px;
    height: 2px;
    background: #0e5a43;
    transform-origin: left;
    transform: scaleX(1);
  }
  .target span {
    font-weight: 700;
  }

  .invoice {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border-strong);
    font-family: var(--font-sans);
    padding: 18px 18px 14px;
  }
  .inv-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--text);
  }
  .inv-top b {
    font: 400 26px/1 var(--font-display);
    letter-spacing: -0.01em;
  }
  .inv-top span {
    color: var(--text-2);
    font-size: 12px;
  }
  .inv-parties {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding-block: 12px;
    font-size: 12px;
    line-height: 1.4;
  }
  .k {
    display: block;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .inv-line {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-block: 12px;
    border-block: 1px solid var(--border);
    font-size: 13px;
  }
  .inv-line small {
    display: block;
    margin-top: 2px;
    font-size: 11px;
    color: var(--text-2);
  }
  .amt {
    font-weight: 500;
    white-space: nowrap;
  }
  .inv-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 12px 6px;
  }
  .inv-total b {
    font: 400 28px/1 var(--font-display);
    color: var(--accent);
  }
  .inv-note {
    font-size: 10.5px;
    color: var(--text-3);
    padding-top: 8px;
    border-top: 1px dashed var(--border);
  }
  .arrow {
    display: none;
    color: var(--text-3);
    align-self: center;
  }
  .arrow svg {
    width: 36px;
    height: 14px;
  }
  .cap {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 12px;
    color: var(--text-3);
  }

  /* Static layout (default, reduced motion, reduced data): page and invoice side by side when wide. */
  @container (min-width: 540px) {
    .stage {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }
    .arrow {
      display: block;
    }
    .cap {
      grid-column: 1 / -1;
    }
  }

  /* The play-once sequence. */
  @media (prefers-reduced-motion: no-preference) {
    .stage {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .logbook,
    .invoice {
      grid-area: 1 / 1;
      width: min(100%, 440px);
    }
    .logbook {
      justify-self: start;
      animation: page-out 640ms var(--ease-move) 2.4s both;
    }
    .invoice {
      justify-self: end;
      animation: inv-in 560ms var(--ease) 2.65s both;
    }
    .arrow {
      display: none !important;
    }
    .cap {
      grid-area: 2 / 1;
    }
    .mark {
      animation: underline 360ms var(--ease) both;
    }
    .f-date .mark {
      animation-delay: 600ms;
    }
    .f-route .mark,
    .f-route2 .mark {
      animation-delay: 1050ms;
    }
    .f-km .mark,
    .f-km2 .mark {
      animation-delay: 1500ms;
    }
    @keyframes underline {
      from {
        transform: scaleX(0);
      }
    }
    @keyframes page-out {
      to {
        opacity: 0;
        transform: translateX(-24px) rotate(-1deg);
        visibility: hidden;
      }
    }
    @keyframes inv-in {
      from {
        opacity: 0;
        transform: translateX(24px);
      }
    }
  }
  /* Save-Data / reduced data where supported: skip the sequence. */
  @media (prefers-reduced-data: reduce) {
    .logbook,
    .invoice,
    .mark {
      animation: none !important;
    }
  }
</style>
