---
// A logbook page gets four fields underlined, then turns into the invoice with the same values.
// Pure HTML and CSS. It plays once, when it scrolls into view, and ends on the invoice.
// Without JavaScript or with reduced motion it shows the page and the invoice side by side.
import { demoTrip as t, logbookFigure as lf } from '../content/site';
---
<figure class="stage" role="img" aria-label={lf.alt}>
  <div class="sheet logbook" aria-hidden="true">
    <div class="lb-head"><span>{lf.head}</span><span>Veh. <u>{t.vehicle}</u></span></div>
    <div class="lb-grid lb-cols">{lf.columns.map((c) => <span>{c}</span>)}</div>
    {lf.rows.map((r) => <div class="lb-grid">{r.map((c) => <span>{c}</span>)}</div>)}
    <div class="lb-grid target">
      <span class="f f-date">{t.date}<i class="mark"></i></span>
      <span>{t.driver}</span>
      <span class="f f-km">{t.out}<i class="mark"></i></span>
      <span class="f f-km2">{t.in}<i class="mark"></i></span>
      <span class="f f-route">{t.from}<i class="mark"></i></span>
      <span class="f f-route2">{t.to}<i class="mark"></i></span>
    </div>
    <div class="lb-grid lb-blank"><span></span></div>
  </div>

  <div class="arrow" aria-hidden="true">
    <svg viewBox="0 0 40 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M0 8h36M30 2l7 6-7 6" /></svg>
  </div>

  <div class="sheet invoice" aria-hidden="true">
    <div class="inv-top"><b>Invoice</b><span>{t.invoiceNo}</span></div>
    <div class="inv-parties">
      <div><span class="k">From</span>{t.company}</div>
      <div><span class="k">Bill to</span>{t.customer}</div>
    </div>
    <div class="inv-line">
      <div>
        <span>{t.from} to {t.to}</span>
        <small>{t.date} &middot; {t.vehicle} &middot; {t.out} to {t.in} &middot; {t.km} km</small>
      </div>
      <span class="amt">{t.amount}</span>
    </div>
    <div class="inv-total"><span>Total due</span><b>{t.amount}</b></div>
    <p class="inv-note">{lf.invoiceNote}</p>
  </div>
</figure>

<style>
  .stage {
    margin: 0;
    display: grid;
    gap: 20px;
    container-type: inline-size;
  }
  .sheet {
    border-radius: 14px;
    font-size: 13px;
    line-height: 1.35;
    box-shadow: var(--shadow-lg);
    container-type: inline-size;
  }
  .logbook {
    background: #fbf8ef;
    color: #2a2a3a;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    padding: 18px 16px 14px;
    transform: rotate(-1.2deg);
    background-image: repeating-linear-gradient(to bottom, transparent 0 25px, rgba(60, 70, 120, 0.15) 25px 26px);
    background-position: 0 32px;
  }
  .lb-head {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    height: 32px;
  }
  .lb-head u {
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .lb-grid {
    display: grid;
    grid-template-columns: 1.1fr 1.2fr 1.1fr 1.1fr 1.2fr 1.2fr;
    gap: 4px;
    height: 26px;
    align-items: end;
    padding-bottom: 3px;
    font-size: clamp(9.5px, 3cqw, 11.5px);
    white-space: nowrap;
  }
  .lb-cols {
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .f {
    position: relative;
    display: inline-block;
  }
  .mark {
    position: absolute;
    left: -2px;
    right: -2px;
    bottom: -3px;
    height: 2px;
    background: var(--accent);
    transform-origin: left;
  }
  .target span {
    font-weight: 700;
  }
  .invoice {
    background: #fff;
    color: var(--text);
    padding: 20px 20px 16px;
    font-family: var(--font-sans);
  }
  .inv-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 12px;
  }
  .inv-top b {
    font: 600 24px/1 var(--font-display);
    letter-spacing: -0.03em;
  }
  .inv-top span {
    color: var(--text-2);
    font-size: 12px;
  }
  .inv-parties {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding-block: 12px;
    font-size: 12.5px;
    line-height: 1.4;
  }
  .k {
    display: block;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .inv-line {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 12px;
    margin-inline: -12px;
    background: var(--tint);
    border-radius: 10px;
    font-size: 13px;
  }
  .inv-line small {
    display: block;
    margin-top: 2px;
    font-size: 11px;
    color: var(--text-2);
  }
  .amt {
    font-weight: 600;
    white-space: nowrap;
  }
  .inv-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 14px 6px;
  }
  .inv-total b {
    font: 600 28px/1 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--accent);
  }
  .inv-note {
    font-size: 10.5px;
    color: var(--text-3);
    padding-top: 6px;
  }
  .arrow {
    display: none;
    color: var(--text-3);
    align-self: center;
  }
  .arrow svg {
    width: 36px;
    height: 14px;
  }

  /* Static layout: page and invoice side by side when wide. */
  @container (min-width: 560px) {
    .stage {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }
    .arrow {
      display: block;
    }
  }

  /* The play-once sequence: starts when the figure scrolls into view (.in is added by the page script). */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .stage {
      grid-template-columns: 1fr;
      align-items: start;
    }
    :global(html.js) .logbook,
    :global(html.js) .invoice {
      grid-area: 1 / 1;
      width: min(100%, 460px);
    }
    :global(html.js) .logbook {
      justify-self: start;
    }
    :global(html.js) .invoice {
      justify-self: end;
      opacity: 0;
    }
    :global(html.js) .arrow {
      display: none;
    }
    :global(html.js) .mark {
      transform: scaleX(0);
    }
    .stage.in .mark {
      animation: underline 420ms var(--ease) both;
    }
    .stage.in .f-date .mark { animation-delay: 700ms; }
    .stage.in .f-route .mark,
    .stage.in .f-route2 .mark { animation-delay: 1200ms; }
    .stage.in .f-km .mark,
    .stage.in .f-km2 .mark { animation-delay: 1700ms; }
    .stage.in .logbook {
      animation: page-out 700ms var(--ease-move) 2.8s both;
    }
    .stage.in .invoice {
      animation: inv-in 640ms var(--ease) 3.05s both;
    }
    @keyframes underline {
      from { transform: scaleX(0); }
      to { transform: scaleX(1); }
    }
    @keyframes page-out {
      to { opacity: 0; transform: translateX(-28px) rotate(-1.2deg); visibility: hidden; }
    }
    @keyframes inv-in {
      from { opacity: 0; transform: translateX(28px) scale(0.98); }
      to { opacity: 1; transform: none; }
    }
  }
</style>
